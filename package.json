{
  "name": "qa-automation-challenge",
  "version": "1.0.0",
  "description": "QA Automation Challenge with Playwright, TypeScript, and API Testing",
  "main": "index.js",
  "scripts": {
    "test": "playwright test || npm run allure:generate",
    "test:ui": "playwright test --project=Chromium --project=Firefox --project=Webkit --project=Mobile-Chrome --project=Mobile-Safari || npm run allure:generate",
    "test:api": "playwright test --project=API || npm run allure:generate",
    "allure:config": "node tests/allure-setup.js",
    "allure:generate": "npm run allure:config && npx allure generate allure-results --clean -o allure-report && node -e \"require('fs').writeFileSync('allure-report/.nojekyll', '')\"",
    "allure:open": "npx allure open allure-report",
    "allure:clear": "npx rimraf allure-results allure-report",
    "test:bdd": "bddgen && playwright test",
    "test:all": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui:mobile": "playwright test --project='Mobile Chrome'",
    "report": "playwright show-report",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "keywords": [
    "playwright",
    "typescript",
    "qa",
    "automation",
    "e2e",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.9.0",
    "@faker-js/faker": "^8.4.1",
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.12.12",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "@typescript-eslint/parser": "^7.9.0",
    "allure-commandline": "^2.40.0",
    "allure-cucumberjs": "^3.8.0",
    "allure-playwright": "^3.8.0",
    "axe-core": "^4.9.0",
    "cucumber-html-reporter": "^7.2.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^1.6.0",
    "multiple-cucumber-html-reporter": "^3.10.0",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "zod": "^3.25.76"
  }
}
